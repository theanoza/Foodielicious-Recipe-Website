<div class="px-4 py-5 my-5 text-center">
    <h1 class="display-5 fw-bold"> Add New Recipe</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead">
            Share your amazing recipies with million people accross the world.
        </p>
    </div>
</div>

<div class="row justify-content-center">
    <% if(infoAddObject != '') { %>
        <div class="col-8 alert alert-success" role="alert">
            <%= infoAddObject %>
        </div>
    <% } %>

    <% if(infoErrorsObject != '') { %>
        <div class="col-8 alert alert-danger" role="alert">
            <%= infoErrorsObject[0].message %>
        </div>
    <% } %>

    <div class="col-8">
        <form action="/addRecipes" enctype="multipart/form-data" method="POST">
            <div class="row g-3">
                <div class="col-12">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email" id="email" class="form-control">
                </div>

                <div class="col-12">
                    <label for="name" class="form-label">Recipe Name</label>
                    <input type="text" name="name" id="name" class="form-control" required>
                </div>

                <div class="col-12">
                    <label for="preparation" class="form-label">Preparation Time</label>
                    <input type="text" name="name" id="name" class="form-control" required>
                </div>

                <div class="col-12">
                    <label for="calories" class="form-label">Calories</label>
                    <input type="text" name="name" id="name" class="form-control" required>
                </div>

                <div class="col-12">
                    <label for="cooking" class="form-label">Cooking Difficulty</label>
                    <select class="form-select form-control" name="cooking" aria-label="Cooking">
                        <option> </option>
                        <option>Easy</option>
                        <option>Medium</option>
                        <option>Difficulty</option>
                    </select>
                </div>

                <div class="col-12">
                    <label for="description" class="form-label">Description</label>
                    <textarea  name="description" id="description" class="form-control" cols="30" rows="4"></textarea>
                </div>

                <div class="col-12">
                    <label for="name" class="form-label">Ingredients</label>
                    <div class="ingredientList">
                        <div class="ingredientDivision mb-1">
                            <input type="text" name="ingredients" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-outline-secondary" id="addIngredientsButton">+ Ingredient</button>
                </div>

                <div class="col-12">
                    <label for="category">Select Category</label>
                    <select class="form-select form-control" name="category" aria-label="Category">
                        <option selected>Select Category</option>
                        <option value="BreakfastBrunchRecipes">Breakfast & Brunch Recipes</option>
                        <option value="LunchRecipes">Lunch Recipes</option>
                        <option value="DinnerRecipes">Dinner Recipes</option>
                        <option value="DessertRecipes">Dessert Recipes</option>
                        <option value="SmoothiesRecipes">Smoothies Recipes</option>
                        <option value="QuickEasyRecipes">Quick & Easy Recipes</option>
                        <option value="VegetarianVeganRecipes">Vegetarian & Vegan Recipes</option>
                        <option value="HealthyRecipes">Healthy Recipes</option>
                        <option value="MediterraneanRecipes">Mediterranean Recipes</option>
                        <option value="PastaRecipes">Pasta Recipes</option>
                    </select>
                </div>

                <div class="col-12">
                    <label for="image">Product Image</label>
                    <input type="file" class="form-control" name="image" accept="images/*">
                </div>

                <div class="col-12">
                    <button type="add" class="btn btn-secondary">Add Recipe</button>
                </div>
            </div>
        </form>
    </div>
</div>