<% if(recipe != null) { %>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%- recipe.name %></li>
        </ol>
    </nav>

    <div class="col-md-2 mb-4" style="margin-left: 800px; display: inline;">
        <a href="/editRecipes" ><img src="/images/edit.png" style="width: 20px; height: 20px;"></a>
        <a href="/deleteRecipes" ><img src="/images/delete.png" style="width: 25px; height: 25px;"></a>
    </div>

    <div class="row">
        <div class="col-12 text-center">
            <h1><%- recipe.name %></h1>
        </div>
        <div class="col-12">
            <img src="/uploads/<%- recipe.image %>" class="img-fluid sticky-top" style="width: 100%;" alt="<%- recipe.name %>">
        </div>

        <div class="row justify-content-md-center">
            <div class="col-md-2 text-center" style="width: 100px; background-color: #FFC7EA; padding: 15px; margin-top: 20px; border-radius: 10px;">
                <img src="/images/sand-clock.png" style="width: 30px; height: 30px;">
                <h5><%- recipe.preparation %></h5>
            </div>
            <div class="col-md-2 text-center" style="width: 100px; background-color: #FBF0B2; padding: 15px; margin-left: 20px; margin-top: 20px; border-radius: 10px;">
                <img src="/images/spoon-and-fork.png" style="width: 30px; height: 30px;">
                <h5><%- recipe.cooking %></h5>
            </div>
            <div class="col-md-2 text-center" style="width: 100px; background-color: #D8B4F8; padding: 15px; margin-left: 20px; margin-top: 20px; border-radius: 10px;">
                <img src="/images/meal.png" style="width: 30px; height: 30px;">
                <h5><%- recipe.calories %></h5>
            </div>
        </div>

        <div class="row pt-4">
            <div class="col-lg-6">
                <h4>Ingredients</h4>
                <ul class="list-group list-group-flush" style="border-radius: 15px;">
                    <% recipe.ingredients.forEach(function(ingredients, index){ %>
                        <li class="list-group-item"><%= ingredients %></li>
                    <% }) %>
                </ul>
            </div>

            <div class="col-lg-6">
                <div class="row">
                    <div class="col-12" style="white-space: pre-line;">
                        <h4>Cooking Instructions</h4>
                        <%- recipe.description %>
                    </div>
                </div>
            </div>
        </div>  
    </div>

    <div class="main-container">
        <div class="progress-container">
            <div class="progress" id="progress"></div>
            <div class="text-wrap active">
                <div class="circle">1</div>
                <p class="text">Complete 1/6</p>
            </div>
            <div class="text-wrap">
                <div class="circle">2</div>
                <p class="text">Complete 2/6</p>
            </div>
            <div class="text-wrap">
                <div class="circle">3</div>
                <p class="text">Complete 3/6</p>
            </div>
            <div class="text-wrap">
                <div class="circle">4</div>
                <p class="text">Complete 4/6</p>
            </div>
            <div class="text-wrap">
                <div class="circle">5</div>
                <p class="text">Complete 5/6</p>
            </div>
            <div class="text-wrap">
                <div class="circle">6</div>
                <p class="text">Complete All</p>
            </div>
        </div>
        <button class="button" id="prev" disabled>&larr; Previous</button>
        <button class="button" id="next">Next &rarr;</button>
    </div>

<% } else { %>
    <p>Nothing Found Here!</p>
<% } %>
