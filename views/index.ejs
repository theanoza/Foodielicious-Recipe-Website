<!--Add Recipes Form-->
<section class="px-4 py-5 my-5 text-center">
    <h3 class="display-5">“A recipe has no soul. You, as the cook, must bring soul to the recipe.” </h3>
    <img src="/images/middlefoto.jpg" class="d-block mx-auto mb-4 img-fluid" alt="Pubish your recipe here" width="500" height="150">
    
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">Share your recipe with us!!</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a href="/addRecipes" class="btn btn-primary btn-dark btn-lg">Add Recipe</a>
        </div>
    </div>
</section>