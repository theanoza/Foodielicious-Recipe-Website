<div class="row flex-lg-row-reverse align-items-center g-5 py-4 mb-4">
    <div class="col-12 col-lg-6">
        <img src="/images/background.jpg" width="480" height="180" class="d-block mx-lg-auto img-fluid" alt="Foodielicious">
    </div>

    <div class="col-12 col-lg-6">
        <h1 class="display-5 fw-bold mb-3">
            Simple recipes made for real, actual, everyday life!!
        </h1>
        <p class="lead">
            Discover delicious recipes for easy desserts, vegan and vegetarian dinner ideas, gorgeous pasta recipes, quick bakes, family-friendly meals and gluten-free recipes.
        </p>

        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <a href="/allRecipes" class="btn btn-primary btn-dark btn-lg px-4 me-md-2">All Recipes</a>
        </div>
    </div>

    <!--Categories-->
    <div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-3 py-4">
        <% if(categories != '') { %>
            <% categories.forEach(function(category, index) { %>
                <a href="/categories" class="col text-center category_link">
                    <div class="category_image shadow">
                        <img src="images/<%- category.image %>" alt="<%- category.name %>" >
                    </div>
                    <div class="pt-1">
                        <%- category.name %>
                    </div>
                </a>
            <% }) %>
        <% } %>

        <a href="/categories" class="col text-center category_link">
            <div class="category_image shadow">
                <img src="images/viewmore.jpg" alt="View More Categories">
            </div>
            <div class="pt-1">
                View More
            </div>
        </a>
    </div>
</div>

<!--All Recipes-->
<section class="pb-4 pt-4">
    <div class="d-flex mb-2 align-items-center">
        <h2>All Recipes</h2>
        <a href="/allRecipes" class="ms-auto">View More</a>
    </div>
    
    <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
        <% if(food != '') { %>
            <% food.latest.forEach(function(recipe, index){ %>
                <a href="/recipe/<%= recipe._id %>" class="col text-center category_link">
                    <div class="category_image category_image_lg shadow">
                        <img src="/uploads/<%= recipe.image %>" alt="<%= recipe.name %>">
                    </div>
                    <div class="pt-1">
                        <%= recipe.name %>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <p>Nothing Found Here!</p>
        <% } %>
    </div>
</section>

